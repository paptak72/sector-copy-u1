# Repozytorium stosuje liste jawnie dopuszczonych plikow. Nowy plik trafia do
# kontroli wersji dopiero po swiadomym dodaniu odpowiedniej reguly ponizej.
/*

!/.gitignore
!/LICENSE
!/Makefile
!/README.md

!/src/
!/src/**
!/cfg/
!/cfg/**
!/tools/
!/tools/**
!/docs/
!/docs/**
!/third_party/
!/third_party/**

# Obrazy ATR sa deterministycznie generowane przez tools/make_test_atr.py.
!/test-disks/
/test-disks/*
!/test-disks/README.md

# Konfiguracja automatyzacji i szablony GitHuba.
!/.github/
!/.github/**

# Metadane AppleDouble oraz pliki tymczasowe.
**/._*
**/__pycache__/
**/*.pyc
**/*~

# Program obsluguje osiem stacji i laczy wariant HSIO z MAXDRIVENO=8.
/src/hsio-1.33-3985-max15.bin
